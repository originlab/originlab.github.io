@model DocumentPageModel

<div class="col-sm-3">
    @if (!String.IsNullOrEmpty(Model.BookUrlName))
    {
        <a class="btn btn-default" href="@(Model.RootUrlPrefix)/de" title="Return home"><span class="glyphicon glyphicon-home"></span></a>
        <a class="btn btn-default" href="@(Model.RootUrlPrefix)/@(Model.BookUrlName)/de" title="Return to book"><span class="glyphicon glyphicon-book"></span></a>
        <a id="doc-btn-parent" class="btn btn-default hidden" title="Go up"><span class="glyphicon glyphicon-arrow-up"></span></a>
    }
    <div id="doc-btn-children" class="btn-group hidden">
        <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
            <span class="glyphicon glyphicon-arrow-down"></span>
            <span class="sr-only">Toggle Dropdown</span>
        </button>
        <ul class="dropdown-menu">
        </ul>
    </div>
</div>
<div class="col-sm-9">
    <div class="form-inline pull-right hidden-xs">
        <div class="form-group">
            <select id="docSearchBook" class="form-control" title="Scope for the search">
                <option selected="selected" value="">All Books</option>
                <optgroup label="Non-Programming Books">
                    <option value="User-Guide">User Guide</option>
                    <option value="Tutorials">Tutorials</option>
                    <option value="Quick-Help">Quick Help</option>
                    <option value="Origin-Help">Origin Help</option>
                    <option value="License">License</option>
                </optgroup>
                <optgroup label="Programming Books">
                    <option value="X-Function">X-Function</option>
                    <option value="OriginC">Origin C</option>
                    <option value="LabTalk">LabTalk Programming</option>
                    <option value="python">Python</option>
                    <option value="ExternalPython">Python (External)</option>
                    <option value="COM">Automation Server</option>
                    <option value="LabVIEW">LabVIEW VI</option>
                    <option value="App">Apps</option>
                    <option value="AppDev">App Development</option>
                    <option value="CodeBuild">Code Builder</option>
                    <option value="Orglab">Orglab</option>
                </optgroup>
            </select>
        </div>
        <div class="form-group">
            <input class="form-control" type="text" placeholder="keywords" id="docSearchInput" />
        </div>
        <div class="form-group">
            <button class="btn btn-default" type="button" title="Suche" onclick="searchDoc('de', 'docSearchInput', 'docSearchBook')">
                Suche
            </button>
        </div>
    </div>
</div>
