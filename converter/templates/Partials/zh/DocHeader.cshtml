@model DocumentPageModel

<div class="col-sm-6">
    <div class="btn-group">
        <button type="button" class="btn btn-default dropdown-toggle" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
                title="Choose language - Sprache auswählen - 言語を選択 - 选择语言">
            简体中文 <span class="caret"></span>
        </button>
        <ul class="dropdown-menu">
            <li><a href="../">English</a></li>
            @if (Model.AvailableLanguages.Contains("de"))
            {
                <li><a href="../de/">Deutsch</a></li>
            }
            @if (Model.AvailableLanguages.Contains("ja"))
            {
                <li><a href="../ja/">日本語</a></li>
            }
        </ul>
    </div>
    @if (!String.IsNullOrEmpty(Model.BookUrlName))
    {
        <a class="btn btn-default" href="@(Model.RootUrlPrefix)/zh/" title="转跳到文档首页"><span class="glyphicon glyphicon-home"></span></a>
        <a class="btn btn-default" href="@(Model.RootUrlPrefix)/@(Model.BookUrlName)/zh/" title="转跳到手册首页"><span class="glyphicon glyphicon-book"></span></a>
        <a id="doc-nav-parent" class="btn btn-default" title="转跳到上级页面"><span class="glyphicon glyphicon-arrow-up"></span></a>
        <div id="doc-nav-siblings" class="btn-group">
            <button type="button" class="btn btn-default dropdown-toggle" title="显示/隐藏同级页面" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="glyphicon glyphicon-sort"></span>
            </button>
            <ul class="dropdown-menu">
            </ul>
        </div>
        <div id="doc-nav-children" class="btn-group">
            <button type="button" class="btn btn-default dropdown-toggle" title="显示/隐藏下级页面" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                <span class="glyphicon glyphicon-arrow-down"></span>
            </button>
            <ul class="dropdown-menu">
            </ul>
        </div>
    }
</div>
<div class="col-sm-6">
    <div class="form-inline pull-right hidden-xs">
        <div class="form-group">
            <select id="docSearchBook" class="form-control" title="搜索范围">
                <option selected="selected" value="">所有手册</option>
                <optgroup label="非编程相关">
                    <option value="User-Guide">用户手册</option>
                    <option value="Tutorials">教程</option>
                    <option value="Quick-Help">快速帮助手册</option>
                    <option value="Origin-Help">Origin 帮助手册</option>
                    <option value="License">Origin 许可证</option>
                    <option value="App">Apps</option>
                </optgroup>
                <optgroup label="编程相关">
                    <option value="X-Function">X-Function</option>
                    <option value="OriginC">Origin C</option>
                    <option value="LabTalk">LabTalk Programming</option>
                    <option value="python">Python</option>
                    <option value="ExternalPython">Python (External)</option>
                    <option value="COM">Automation Server</option>
                    <option value="LabVIEW">LabVIEW VI</option>
                    <option value="AppDev">App Development</option>
                    <option value="CodeBuild">Code Builder</option>
                    <option value="Orglab">Orglab</option>
                </optgroup>
            </select>
        </div>
        <div class="form-group">
            <input class="form-control" type="text" placeholder="关键词" id="docSearchInput" />
        </div>
        <div class="form-group">
            <button class="btn btn-default" type="button" title="搜索" onclick="searchDoc('zh', 'docSearchInput', 'docSearchBook')">
                搜索
            </button>
        </div>
    </div>
</div>
