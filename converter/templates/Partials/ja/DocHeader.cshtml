@model DocumentPageModel

<div class="col-sm-3">
    <a class="btn btn-default" href="@(Model.RootUrlPrefix)/ja" title="Return home"><span class="glyphicon glyphicon-home"></span></a>
    @if (!String.IsNullOrEmpty(Model.BookUrlName))
    {
        <a class="btn btn-default" href="@(Model.RootUrlPrefix)/@(Model.BookUrlName)/ja" title="Return to book"><span class="glyphicon glyphicon-book"></span></a>
    }
</div>
<div class="col-sm-9">
    <div class="form-inline pull-right hidden-xs">
        <div class="form-group">
            <select id="docSearchBook" class="form-control" title="Scope for the search">
                <option selected="selected" value="">全ての書籍</option>
                <optgroup label="Non-Programming Books">
                    <option value="User-Guide">ユーザガイド</option>
                    <option value="Tutorials">チュートリアル</option>
                    <option value="Quick-Help">クイックヘルプ</option>
                    <option value="Origin-Help">Originヘルプ</option>
                </optgroup>
                <optgroup label="Programming Books">
                    <option value="X-Function">Xファンクション</option>
                    <option value="OriginC">Origin C</option>
                    <option value="LabTalk">LabTalk プログラミング</option>
                    <option value="python">Python</option>
                    <option value="ExternalPython">Python (External)</option>
                    <option value="COM">Automation Server</option>
                    <option value="LabVIEW">LabVIEW VI</option>
                    <option value="App">Apps</option>
                    <option value="AppDev">App Development</option>
                    <option value="CodeBuild">Code Builder</option>
                    <option value="License">ライセンス</option>
                    <option value="Orglab">Orglab</option>
                </optgroup>
            </select>
            <label for="docSearchBook">から</label>
        </div>
        <div class="form-group">
            <input class="form-control" type="text" placeholder="何か" id="docSearchInput" />
        </div>
        <div class="form-group">
            <button class="btn btn-default" type="button" title="検索" onclick="searchDoc('ja', 'docSearchInput', 'docSearchBook')">
                検索
            </button>
        </div>
    </div>
</div>
